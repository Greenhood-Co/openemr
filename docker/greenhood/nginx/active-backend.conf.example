# Template for active-backend.conf, which is deliberately untracked: it holds live routing
# state, and a tracked copy would be reverted to this default by git pull mid-deploy.
#
# Seed it once per checkout, before the first `docker compose up`:
#   cp docker/greenhood/nginx/active-backend.conf.example docker/greenhood/nginx/active-backend.conf
#
# After that, deploy.sh owns the file and toggles the blue/green IP.
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_read_timeout 300s;
proxy_connect_timeout 75s;
proxy_pass http://172.29.8.11:80;
